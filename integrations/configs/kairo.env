# Kairo environment configuration for awdemos platform
# Source this file before starting kairo

# Kairo API server settings
export KAIRO_PORT=3000
export KAIRO_LOG=info

# Required: at least one provider API key
# export OPENAI_API_KEY="sk-..."
# export ANTHROPIC_API_KEY="sk-ant-..."
# export GEMINI_API_KEY="..."

# Optional: Xfiles integration
# When set, kairo will register itself with Xfiles on startup
export XFILES_URL="http://localhost:9999"
export XFILES_API_KEY="xfiles-secret"
